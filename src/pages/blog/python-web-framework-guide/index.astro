            <a href="/services/" class="btn btn-outline-orange ms-2 px-4 py-2 fw-bold">View Services</a>
          </div>
        </div>
      </article>
      <FAQ count={3} category="web" city="Pakistan" gigName="Python Web Framework" />
    </div>
  </section>
  <Footer slot="footer" />
  <WhatsappWidget slot="widget" />
</Layout>