const title = 'Technical SEO Audit Guide: Fix Speed & CWV | SEO Ustaad';
const description = 'A complete technical SEO audit checklist for Pakistani websites — Core Web Vitals, crawlability, indexing, site speed, mobile usability, and schema markup fixes that move rankings.';
const canonicalUrl = 'https://www.seoustaad.com/blog/technical-seo-audit-guide-pakistan/';
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <Header slot="header" />

  <section class="py-5" style="padding-top:140px!important;background:var(--bg-dark)">
    <div class="container py-4">
      <a href="/blog/" class="text-orange text-decoration-none small mb-3 d-inline-block">&larr; Back to Blog</a>
