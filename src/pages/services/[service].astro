---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsappWidget from '../../components/WhatsappWidget.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';
import gigs from '../../../gigs.json';
import faqsData from '../../../faqs.json';

export function getStaticPaths() {
    const cities = [
        'Karachi', 'Lahore', 'Faisalabad', 'Rawalpindi', 'Gujranwala', 'Peshawar', 'Multan', 'Hyderabad',
        'Islamabad', 'Quetta', 'Bahawalpur', 'Sargodha', 'Sialkot', 'Sukkur', 'Larkana', 'Sheikhupura',
        'Rahim Yar Khan', 'Jhang', 'Dera Ghazi Khan', 'Gujrat', 'Sahiwal', 'Wah Cantonment', 'Mardan', 'Kasur', 'Okara'
    ];
    const paths = [];
    gigs.forEach(gig => {
        paths.push({
            params: { service: gig.slug },
            props: { gig, isMatrix: false, city: null, citySlug: null }
        });
        // Gigs whose slug already bakes in a location (e.g. "website-development-in-karachi")
        // must not be run through the city matrix again — that produced nonsense duplicates
        // like "website-development-in-karachi-in-karachi".
        if (gig.slug.includes('-in-')) return;
        cities.forEach(city => {
            const citySlug = city.toLowerCase().replace(/\s+/g, '-');
            paths.push({
                params: { service: gig.slug + '-in-' + citySlug },
                props: { gig, isMatrix: true, city, citySlug }
            });
        });
    });
    return paths;
}

const { gig, isMatrix, city, citySlug } = Astro.props;
const slug = Astro.params.service;

// Optimize titles to ensure they stay within Google's 50-60 character limit without truncation
const cleanGigName = gig.name
  .replace(/\s*\[.*?\]/g, '')
  .replace(/\s*\(.*?\)/g, '')
  .replace(/\s*–\s*Full Store Setup/g, '')
  .trim()
  .replace('Comprehensive Keyword Research & Competitor Gap Analysis', 'Keyword Research & Competitor Analysis')
  .replace('Premium Google Business Profile Setup & Ranking', 'Google Business Profile Setup & Ranking')
  .replace('Highly-Converting Geo-Targeted Landing Page Copywriting', 'Geo-Targeted Landing Page Copywriting')
  .replace('Premium Custom WordPress development full website', 'Custom WordPress Website Development')
  .replace('Premium custom Shopify Store development and Setup', 'Custom Shopify Store Development')
  .replace('Premium Disavow Toxic Backlinks & Penalty Recovery', 'Toxic Backlinks Disavow & Penalty Recovery')
  .replace('Premium Schema Markup & Advanced Structured Data', 'Schema Markup & Advanced Structured Data')
  .replace('Complete On-Page SEO Optimization', 'On-Page SEO Optimization')
  .replace('Premium Local Citations & High-DA Directory Listings', 'Local Citations & Directory Listings')
  .replace('Premium Local SEO Monthly Retainer', 'Local SEO Monthly Retainer')
  .replace('Premium Shopify/WooCommerce Product SEO', 'Shopify & WooCommerce Product SEO')
  .replace('Advanced Conversion Rate Optimization Audit', 'Conversion Rate Optimization (CRO) Audit')
  .replace('Premium E-Commerce Architecture & Silo Restructure', 'E-Commerce Architecture & Silo Restructure')
  .replace('Advanced Competitor Backlink Intercept Strategy', 'Competitor Backlink Intercept Strategy')
  .replace('High-Converting Ad Copywriting & Creative Strategy', 'Ad Copywriting & Creative Strategy')
  .replace('5 Ultra High-DR Guest Post Backlinks', '5 High-DR Guest Post Backlinks')
  .replace('Premium Social Media Management', 'Social Media Management')
  .replace('Website Development Company in Pakistan', 'Website Development Company')
  .replace('Website Development Services in Pakistan', 'Website Development Services')
  .replace('Website Development Cost in Pakistan', 'Website Development Cost')
  .replace('Website Development Price in Pakistan', 'Website Development Price')
  .replace('Website Development Company in Karachi', 'Web Development Company Karachi')
  .replace('Website Development Company in Islamabad', 'Web Development Company Islamabad')
  .replace('Advanced E-Commerce SEO Strategy & Packages', 'E-Commerce SEO Strategy & Packages')
  .replace('E-Commerce WordPress & WooCommerce Development', 'WooCommerce & WordPress Development')
  .replace('Shopify Development Partner', 'Shopify Development Services');

let formattedTitle = isMatrix ? `${cleanGigName} in ${city} | SEO Ustaad` : `${cleanGigName} | SEO Ustaad`;
if (formattedTitle.length > 60) {
  const maxLen = 60 - (isMatrix ? ` in ${city} | SEO Ustaad`.length : ' | SEO Ustaad'.length);
  if (maxLen > 10) {
    const trimmed = cleanGigName.slice(0, maxLen).trim().replace(/[,&–-]$/, '');
    formattedTitle = isMatrix ? `${trimmed} in ${city} | SEO Ustaad` : `${trimmed} | SEO Ustaad`;
  }
}
const title = formattedTitle;
const keywordDescriptions = {
  'custom-web-app-development': 'Custom web app development by SEO Ustaad. Build scalable, performant web applications with React, Next.js & Node.js. Starting at 30,000 PKR.',
  'react-nextjs-development': 'React & Next.js development services. Modern, fast, and SEO-friendly web applications built by Pakistan\'s top dev agency. Starting at 30,000 PKR.',
  'custom-software-development': 'Custom software development services — web apps, APIs, and enterprise solutions. SEO Ustaad delivers ROI-driven software at affordable prices.',
  'web-application-development-services': 'Professional web application development services by SEO Ustaad. Build scalable, feature-rich web applications with modern tech stacks. Starting at 25,000 PKR.',
  'custom-web-development-agency': 'Custom web development agency services by SEO Ustaad. Full-service web development, design, and SEO-optimized builds. Starting at 20,000 PKR.',
  'website-development': 'Get professional website development services by SEO Ustaad. Custom web development, responsive design, and SEO-optimized sites starting at 20,000 PKR.',
  'custom-website-development': 'Custom website development services tailored to your business. SEO Ustaad builds high-performance, GEO-optimized custom websites starting at 30,000 PKR.',
};
const description = isMatrix
    ? `Looking for ${gig.name} in ${city}? SEO Ustaad offers premium ${gig.category} services in ${city} starting at ${gig.price}. Dominate your local market today!`
    : (keywordDescriptions[gig.slug] || `Get professional ${gig.name} services by SEO Ustaad. We specialize in ROI-driven ${gig.category} and custom solutions for startups to boost your rankings. Premium quality starting at ${gig.price}. Order directly on WhatsApp!`);
const canonicalUrl = `https://www.seoustaad.com/services/${slug}/`;
const priceAmount = (gig.price.match(/[\d,]+/)?.[0] || '').replace(/,/g, '');

const serviceSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": isMatrix ? `${gig.name} in ${city}` : gig.name,
    "description": description,
    "serviceType": gig.category,
    "provider": {
        "@type": "ProfessionalService",
        "name": "SEO Ustaad",
        "url": "https://www.seoustaad.com/"
    },
    ...(isMatrix && {
        "areaServed": {
            "@type": "City",
            "name": city
        }
    }),
    "offers": {
        "@type": "Offer",
        "price": priceAmount,
        "priceCurrency": "PKR",
        "url": canonicalUrl
    }
});
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
    <script type="application/ld+json" set:html={serviceSchema} slot="header" />
    <Header slot="header" />
    
    <header class="hero-section" style="padding-top:120px">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="container position-relative z-2">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 text-center text-lg-start stagger-reveal">
                    <div class="badge bg-darker border border-white border-opacity-25 px-3 py-2 rounded-pill mb-4 text-white small d-inline-flex align-items-center mx-auto mx-lg-0 glow-effect">
                        <span class="pulse-dot bg-orange rounded-circle me-2"></span> Top Rated Agency
                    </div>
                    <h1 class="display-3 fw-bold mb-4 outfit lh-sm">
                        {gig.name} {isMatrix && `in ${city}`} <br> 
                        <span class="text-gradient">Only {gig.price}</span>
                    </h1>
                    <p class="lead text-gray mb-5">Premium local SEO and Web Development services starting at just 5,000 PKR.</p>
                    <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                        <a href="/services/" class="btn btn-orange px-4 py-3 fw-semibold">View Our 25 Premium Gigs</a>
                    </div>
                </div>
                <div class="col-lg-6 order-2 stagger-reveal stagger-delay-3">
                    <LeadForm defaultServiceSlug={gig.slug} defaultCity={city || ''} />
                </div>
            </div>
        </div>
    </header>

    <section id="about-us" class="py-5 bg-darker">
        <div class="container py-5">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h2 class="outfit display-5 text-white">Local Authority <span class="text-orange">You Can Trust</span></h2>
                    <p class="text-gray lead mt-3">We don't just do basic SEO. We engineer generative engine optimized entities that rank on Google, ChatGPT, and Gemini.</p>
                    <ul class="list-unstyled text-white mt-4">
                        <li class="mb-3"><i class="fas fa-check-circle text-orange me-2"></i> Over 1,000+ Local Businesses Scaled</li>
                        <li class="mb-3"><i class="fas fa-check-circle text-orange me-2"></i> Data-Driven 25-Gig Methodology</li>
                        <li class="mb-3"><i class="fas fa-check-circle text-orange me-2"></i> Transparent Pricing (5k - 30k PKR)</li>
                    </ul>
                </div>
                <div class="col-lg-6 text-center">
                    <img src="/images/logo.svg" alt={`SEO Ustaad ${gig.name}`} title={`SEO Ustaad — ${gig.name}`} width="300" height="300" class="img-fluid rounded-4 shadow-lg opacity-75" style="max-width:300px;mix-blend-mode:screen">
                </div>
            </div>
        </div>
    </section>

    <!-- Detailed Gig Niche Context info -->
    <section class="py-5 bg-dark">
        <div class="container py-5 stagger-reveal">
            <h2 class="outfit h3 text-white mb-4">Why {gig.name} {isMatrix && `in ${city}`}?</h2>
            <p class="text-gray mb-3">Ranking your business {isMatrix && `in ${city}`} requires specialized local knowledge. Our <strong>{gig.name}</strong> service combines our top-tier {gig.category} expertise with localized strategies. Whether you're targeting specific niches or scaling nationally, we've got you covered.</p>
            <p class="text-gray mb-4">Starting at just <strong>{gig.price}</strong>, this is the most cost-effective way to dominate the digital landscape. Let our experts build a roadmap tailored to your competitors.</p>
            {isMatrix && (
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href={`/locations/seo-agency-${citySlug}/`} class="btn btn-outline-orange rounded-pill px-4">View All Services in {city}</a>
                    <a href={`/services/${gig.slug}/`} class="btn btn-outline-orange rounded-pill px-4">Learn More About {gig.name}</a>
                </div>
            )}
        </div>
    </section>

    <!-- Comprehensive Deliverables & Scope of Work -->
    <section class="py-5 bg-darker border-top border-white border-opacity-10">
        <div class="container py-4">
            <div class="row align-items-center mb-5">
                <div class="col-lg-8">
                    <span class="text-orange text-uppercase fw-bold small tracking-wider">Scope of Service</span>
                    <h2 class="outfit display-6 text-white mt-2">What Is Included in <span class="text-orange">{gig.name}</span></h2>
                    <p class="text-gray mt-2">Every package is meticulously executed by seasoned senior specialists following white-hat, algorithm-resilient standards to yield measurable business growth.</p>
                </div>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="p-4 rounded-4 h-100" style="background:var(--surface-dark-elevated);border:1px solid rgba(255,255,255,.08)">
                        <div class="text-orange fs-3 mb-3"><i class="fas fa-microchip"></i></div>
                        <h3 class="h5 text-white outfit mb-2">Deep Strategic Audit</h3>
                        <p class="text-gray small mb-0">Complete evaluation of existing assets, code performance, competitor gaps, and baseline visibility metrics across target markets.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="p-4 rounded-4 h-100" style="background:var(--surface-dark-elevated);border:1px solid rgba(255,255,255,.08)">
                        <div class="text-orange fs-3 mb-3"><i class="fas fa-layer-group"></i></div>
                        <h3 class="h5 text-white outfit mb-2">Tailored Execution</h3>
                        <p class="text-gray small mb-0">Hands-on implementation designed specifically around your industry niche, local geography, and user intent triggers.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="p-4 rounded-4 h-100" style="background:var(--surface-dark-elevated);border:1px solid rgba(255,255,255,.08)">
                        <div class="text-orange fs-3 mb-3"><i class="fas fa-shield-halved"></i></div>
                        <h3 class="h5 text-white outfit mb-2">Quality & Schema Validation</h3>
                        <p class="text-gray small mb-0">Rigorous debugging against Google search standards, Schema.org guidelines, Core Web Vitals, and responsive cross-device usability.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="p-4 rounded-4 h-100" style="background:var(--surface-dark-elevated);border:1px solid rgba(255,255,255,.08)">
                        <div class="text-orange fs-3 mb-3"><i class="fas fa-chart-line"></i></div>
                        <h3 class="h5 text-white outfit mb-2">Transparent Reporting</h3>
                        <p class="text-gray small mb-0">Detailed action summary, verified live links or codebase commits, and actionable roadmap recommendations for future momentum.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4-Step Proven Methodology -->
    <section class="py-5 bg-dark">
        <div class="container py-4">
            <div class="text-center max-w-700 mx-auto mb-5">
                <span class="text-orange text-uppercase fw-bold small tracking-wider">How We Work</span>
                <h2 class="outfit display-6 text-white mt-2">Our 4-Stage Execution Methodology</h2>
                <p class="text-gray">From initial requirement intake to final delivery and post-launch monitoring, our systematic workflow ensures predictable, high-impact outcomes.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3 text-center text-md-start">
                    <div class="p-3">
                        <div class="display-6 fw-bold text-orange mb-2">01</div>
                        <h4 class="h6 text-white fw-bold mb-2">Discovery & Intake</h4>
                        <p class="text-gray small">We gather business credentials, current search rankings, target customer profiles, and competitive benchmarks.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 text-center text-md-start">
                    <div class="p-3">
                        <div class="display-6 fw-bold text-orange mb-2">02</div>
                        <h4 class="h6 text-white fw-bold mb-2">Blueprint & Action Plan</h4>
                        <p class="text-gray small">Our lead engineers craft a customized delivery schedule with transparent milestone tracking tailored to your timeline.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 text-center text-md-start">
                    <div class="p-3">
                        <div class="display-6 fw-bold text-orange mb-2">03</div>
                        <h4 class="h6 text-white fw-bold mb-2">Precision Implementation</h4>
                        <p class="text-gray small">We perform clean, manual changes directly in your CMS, codebase, or backlink profile with zero shortcuts or automated spam.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 text-center text-md-start">
                    <div class="p-3">
                        <div class="display-6 fw-bold text-orange mb-2">04</div>
                        <h4 class="h6 text-white fw-bold mb-2">Review & Post-Launch Support</h4>
                        <p class="text-gray small">We verify indexing, measure impact, and provide responsive WhatsApp handover support to ensure long-term stability.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <FAQ count={5} category={gig.category} city={city || 'Pakistan'} citySlug={citySlug} gigName={gig.name} />
    <Footer slot="footer" />
    <WhatsappWidget slot="widget" />
</Layout>
